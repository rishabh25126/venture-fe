# Copy to `.env.local` for local overrides (never commit secrets).

# --- API base URL (production / `next build` only) ---
# `next dev` always uses `/backend` (Next rewrite → local Express); this var is ignored in dev
# so `.env.local` can hold production values without breaking local API calls.
# Must include the `/api` prefix (paths are like `/auth/login` → `/api/auth/login` on the server).
# NEXT_PUBLIC_API_URL=https://venture-be.vercel.app/api

# When unset in production: defaults to https://venture-be.vercel.app/api

# Optional: treat as dev for base URL selection (same as NODE_ENV=development for this purpose).
# NEXT_PUBLIC_APP_ENV=development

# --- Dev-only: Next.js rewrite `/backend/*` → local backend ---
# Default: http://localhost:5000/api (matches server PORT in server/.env.example).
# Override if your API runs on another host/port.
# BACKEND_REWRITE_TARGET=http://localhost:5001/api
